# Copy to .env.local. Never commit credentials or use NEXT_PUBLIC_ for these.
AUTH_PROVIDER=password
JOURNAL_VISIBILITY=private
APP_URL=http://localhost:3000
SESSION_SECRET=
# Stable journal owner. Keep this unchanged after the first record is saved.
JOURNAL_OWNER_ID=journal-owner
# Generate salted hashes with npm run password:hash (password supplied on stdin).
ADMIN_PASSWORD_HASH=
# Optional distinct, read-only sharing password.
VIEWER_PASSWORD_HASH=
# Vercel: configure WAF first, then vercel-waf. Single-host Node.js: file.
# Optional shared Redis limiter: redis (requires KV configuration below).
PASSWORD_RATE_LIMIT=
# Optional persistent local directory for file mode (default .local/login-rate-limit).
PASSWORD_RATE_LIMIT_DIR=
# Private repository initialized with a README.
GITHUB_DATA_REPOSITORY=
GITHUB_DATA_BRANCH=main
# Fine-grained PAT: selected private data repository only, Contents read/write.
GITHUB_DATA_TOKEN=
# Optional OAuth mode: AUTH_PROVIDER=github and matching JOURNAL_OWNER_ID/user ID.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ALLOWED_USER_ID=

# Optional online place autocomplete. Server-only; omit for local suggestions.
GEOAPIFY_API_KEY=

# Optional short-lived server coordination. GitHub remains the primary store.
# Enable only after a Free Upstash database is connected and verified; see docs/KV.md.
JOURNAL_KV=off
# Unique per project + environment. Never share production namespace with previews.
JOURNAL_KV_NAMESPACE=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Marketplace may supply KV_REST_API_URL / KV_REST_API_TOKEN instead (supported).
# Optional distributed login limit: PASSWORD_RATE_LIMIT=redis (5 global attempts/60s).
